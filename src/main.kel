type Json struct {
    kind str
    boolean bool
    number f64
    text str
    items Array<Json>
    fields Dict<str, Json>
}

type _Parser struct {
    input str
    cursor i64
}

fn _new(kind str) Json {
    var value Json = Json()
    value.kind = kind
    value.items = Array<Json>()
    value.fields = Dict<str, Json>()
    return value
}

fn nullValue() Json { return _new("null") }

fn boolValue(value bool) Json {
    var result Json = _new("bool")
    result.boolean = value
    return result
}

fn numberValue(value f64) Json {
    _numberText(value)
    var result Json = _new("number")
    result.number = value
    return result
}

fn stringValue(value str) Json {
    var result Json = _new("string")
    result.text = value
    return result
}

fn arrayValue(value Array<Json>) Json {
    var result Json = _new("array")
    result.items = value
    return result
}

fn objectValue(value Dict<str, Json>) Json {
    var result Json = _new("object")
    result.fields = value
    return result
}

fn _requireKind(value Json, expected str) void {
    if (value.kind != expected) error("expected JSON " + expected + ", found " + value.kind)
}

fn kindOf(value Json) str { return value.kind }

fn isNull(value Json) bool { return value.kind == "null" }

fn asBool(value Json) bool {
    _requireKind(value, "bool")
    return value.boolean
}

fn asNumber(value Json) f64 {
    _requireKind(value, "number")
    return value.number
}

fn asString(value Json) str {
    _requireKind(value, "string")
    return value.text
}

fn asArray(value Json) Array<Json> {
    _requireKind(value, "array")
    return value.items
}

fn asObject(value Json) Dict<str, Json> {
    _requireKind(value, "object")
    return value.fields
}

fn _isWhitespace(code i64) bool {
    return code == 32 || code == 9 || code == 10 || code == 13
}

fn _skipWhitespace(parser _Parser) void {
    while (parser.cursor < len(parser.input) && _isWhitespace(charCodeAt(parser.input, parser.cursor))) {
        parser.cursor = parser.cursor + 1
    }
}

fn _consume(parser _Parser, code i64) bool {
    _skipWhitespace(parser)
    if (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) == code) {
        parser.cursor = parser.cursor + 1
        return true
    }
    return false
}

fn _expectWord(parser _Parser, word str) void {
    var index i64 = 0
    while (index < len(word)) {
        if (parser.cursor >= len(parser.input) || charCodeAt(parser.input, parser.cursor) != charCodeAt(word, index)) {
            error("invalid JSON literal")
        }
        parser.cursor = parser.cursor + 1
        index = index + 1
    }
}

fn _parseString(parser _Parser) str {
    if (!_consume(parser, 34)) error("expected JSON string")
    var out str = ""
    while (parser.cursor < len(parser.input)) {
        var code i64 = charCodeAt(parser.input, parser.cursor)
        parser.cursor = parser.cursor + 1
        if (code == 34) return out
        if (code != 92) {
            if (code < 32) error("unescaped control character in JSON string")
            out = out + charFromCode(code)
        } else {
            if (parser.cursor >= len(parser.input)) error("unterminated JSON escape")
            code = charCodeAt(parser.input, parser.cursor)
            parser.cursor = parser.cursor + 1
            if (code == 34 || code == 92 || code == 47) {
                out = out + charFromCode(code)
            } else if (code == 98) {
                out = out + charFromCode(8)
            } else if (code == 102) {
                out = out + charFromCode(12)
            } else if (code == 110) {
                out = out + "\n"
            } else if (code == 114) {
                out = out + "\r"
            } else if (code == 116) {
                out = out + "\t"
            } else if (code == 117) {
                out = out + _parseUnicodeEscape(parser)
            } else {
                error("invalid JSON escape")
            }
        }
    }
    error("unterminated JSON string")
}

fn _hexValue(code i64) i64 {
    if (code >= 48 && code <= 57) return code - 48
    if (code >= 65 && code <= 70) return code - 55
    if (code >= 97 && code <= 102) return code - 87
    return -1
}

fn _utf8(code i64) str {
    if (code <= 127) return charFromCode(code)
    if (code <= 2047) return charFromCode(192 + code / 64) + charFromCode(128 + code - (code / 64) * 64)
    if (code <= 65535) return charFromCode(224 + code / 4096) + charFromCode(128 + (code / 64 - (code / 4096) * 64)) + charFromCode(128 + code - (code / 64) * 64)
    return charFromCode(240 + code / 262144) + charFromCode(128 + (code / 4096 - (code / 262144) * 64)) + charFromCode(128 + (code / 64 - (code / 4096) * 64)) + charFromCode(128 + code - (code / 64) * 64)
}

fn _parseUnicodeEscape(parser _Parser) str {
    if (parser.cursor + 4 > len(parser.input)) error("incomplete JSON unicode escape")
    var code i64 = 0
    var index i64 = 0
    while (index < 4) {
        var digit i64 = _hexValue(charCodeAt(parser.input, parser.cursor))
        if (digit < 0) error("invalid JSON unicode escape")
        code = code * 16 + digit
        parser.cursor = parser.cursor + 1
        index = index + 1
    }
    if (code >= 55296 && code <= 56319) {
        if (parser.cursor + 6 > len(parser.input) || charCodeAt(parser.input, parser.cursor) != 92 || charCodeAt(parser.input, parser.cursor + 1) != 117) error("unpaired JSON unicode surrogate")
        parser.cursor = parser.cursor + 2
        var low i64 = 0
        index = 0
        while (index < 4) {
            var digit i64 = _hexValue(charCodeAt(parser.input, parser.cursor))
            if (digit < 0) error("invalid JSON unicode escape")
            low = low * 16 + digit
            parser.cursor = parser.cursor + 1
            index = index + 1
        }
        if (low < 56320 || low > 57343) error("unpaired JSON unicode surrogate")
        return _utf8(65536 + (code - 55296) * 1024 + low - 56320)
    }
    if (code >= 56320 && code <= 57343) error("unpaired JSON unicode surrogate")
    return _utf8(code)
}

fn _parseNumber(parser _Parser) f64 {
    var start i64 = parser.cursor
    if (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) == 45) parser.cursor = parser.cursor + 1
    if (parser.cursor >= len(parser.input)) error("invalid JSON number")
    if (charCodeAt(parser.input, parser.cursor) == 48) {
        parser.cursor = parser.cursor + 1
        if (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) >= 48 && charCodeAt(parser.input, parser.cursor) <= 57) error("leading zero in JSON number")
    } else if (charCodeAt(parser.input, parser.cursor) >= 49 && charCodeAt(parser.input, parser.cursor) <= 57) {
        while (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) >= 48 && charCodeAt(parser.input, parser.cursor) <= 57) parser.cursor = parser.cursor + 1
    } else { error("invalid JSON number") }
    if (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) == 46) {
        parser.cursor = parser.cursor + 1
        if (parser.cursor >= len(parser.input) || charCodeAt(parser.input, parser.cursor) < 48 || charCodeAt(parser.input, parser.cursor) > 57) error("invalid JSON number fraction")
        while (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) >= 48 && charCodeAt(parser.input, parser.cursor) <= 57) parser.cursor = parser.cursor + 1
    }
    if (parser.cursor < len(parser.input) && (charCodeAt(parser.input, parser.cursor) == 69 || charCodeAt(parser.input, parser.cursor) == 101)) {
        parser.cursor = parser.cursor + 1
        if (parser.cursor < len(parser.input) && (charCodeAt(parser.input, parser.cursor) == 43 || charCodeAt(parser.input, parser.cursor) == 45)) parser.cursor = parser.cursor + 1
        if (parser.cursor >= len(parser.input) || charCodeAt(parser.input, parser.cursor) < 48 || charCodeAt(parser.input, parser.cursor) > 57) error("invalid JSON number exponent")
        while (parser.cursor < len(parser.input) && charCodeAt(parser.input, parser.cursor) >= 48 && charCodeAt(parser.input, parser.cursor) <= 57) parser.cursor = parser.cursor + 1
    }
    return parseFloat(slice(parser.input, start, parser.cursor))
}

fn _parseValue(parser _Parser) Json {
    _skipWhitespace(parser)
    if (parser.cursor >= len(parser.input)) error("unexpected end of JSON")
    var code i64 = charCodeAt(parser.input, parser.cursor)
    if (code == 34) {
        var value Json = _new("string")
        value.text = _parseString(parser)
        return value
    }
    if (code == 123) {
        parser.cursor = parser.cursor + 1
        var value Json = _new("object")
        _skipWhitespace(parser)
        if (_consume(parser, 125)) return value
        while (true) {
            var key str = _parseString(parser)
            if (!_consume(parser, 58)) error("expected ':' in JSON object")
            value.fields[key] = _parseValue(parser)
            if (_consume(parser, 125)) return value
            if (!_consume(parser, 44)) error("expected ',' in JSON object")
        }
    }
    if (code == 91) {
        parser.cursor = parser.cursor + 1
        var value Json = _new("array")
        _skipWhitespace(parser)
        if (_consume(parser, 93)) return value
        while (true) {
            value.items.push(_parseValue(parser))
            if (_consume(parser, 93)) return value
            if (!_consume(parser, 44)) error("expected ',' in JSON array")
        }
    }
    if (code == 116) {
        _expectWord(parser, "true")
        var value Json = _new("bool")
        value.boolean = true
        return value
    }
    if (code == 102) {
        _expectWord(parser, "false")
        var value Json = _new("bool")
        value.boolean = false
        return value
    }
    if (code == 110) {
        _expectWord(parser, "null")
        return _new("null")
    }
    if (code == 45 || (code >= 48 && code <= 57)) {
        var value Json = _new("number")
        value.number = _parseNumber(parser)
        return value
    }
    error("invalid JSON value")
}

fn parse(text str) Json {
    var parser _Parser = _Parser()
    parser.input = text
    parser.cursor = 0
    var value Json = _parseValue(parser)
    _skipWhitespace(parser)
    if (parser.cursor != len(parser.input)) error("trailing JSON input")
    return value
}

fn _numberText(value f64) str {
    var text str = str(value)
    if (text == "nan" || text == "inf" || text == "-inf") error("JSON numbers must be finite")
    return text
}

fn _quote(text str) str {
    var out str = charFromCode(34)
    for (var character str : text) {
        var code i64 = charCodeAt(character, 0)
        if (code == 34 || code == 92) {
            out = out + charFromCode(92) + character
        } else if (code == 10) {
            out = out + charFromCode(92) + "n"
        } else if (code == 13) {
            out = out + charFromCode(92) + "r"
        } else if (code == 9) {
            out = out + charFromCode(92) + "t"
        } else if (code < 32) {
            var hex str = "0123456789abcdef"
            out = out + charFromCode(92) + "u00" + charFromCode(charCodeAt(hex, code / 16)) + charFromCode(charCodeAt(hex, code - (code / 16) * 16))
        } else {
            out = out + character
        }
    }
    return out + charFromCode(34)
}

fn stringify(value Json) str {
    if (value.kind == "null") return "null"
    if (value.kind == "bool") {
        if (value.boolean) return "true"
        return "false"
    }
    if (value.kind == "number") return _numberText(value.number)
    if (value.kind == "string") return _quote(value.text)
    if (value.kind == "array") {
        var out str = "["
        var index i64 = 0
        while (index < value.items.size()) {
            if (index > 0) out = out + ","
            out = out + stringify(value.items[index])
            index = index + 1
        }
        return out + "]"
    }
    if (value.kind == "object") {
        var out str = "{"
        var keys Array<str> = value.fields.keys()
        var index i64 = 0
        while (index < keys.size()) {
            if (index > 0) out = out + ","
            var key str = keys[index]
            out = out + _quote(key) + ":" + stringify(value.fields[key])
            index = index + 1
        }
        return out + "}"
    }
    error("unknown JSON value kind")
}
